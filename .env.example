# Copy this file to .env and fill in the real values.
# .env is gitignored; the same names must also be set in Vercel
# (Settings -> Environment Variables) or the build will fail.
#
# Note: a Firebase web config is shipped inside the JS bundle and is therefore
# visible to any visitor. Keeping it out of git only avoids secret scanning
# alerts. The real protection is Realtime Database security rules plus HTTP
# referrer restrictions on the key in Google Cloud Console.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=countvisportf.firebaseapp.com
FIREBASE_DATABASE_URL=https://countvisportf-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=countvisportf
FIREBASE_STORAGE_BUCKET=countvisportf.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=22584054345
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Chatbot backend endpoint. The LLM provider key belongs on that backend,
# never in this Angular app.
API_CHATBOT=https://chatme.documentme.my.id/api/chat
